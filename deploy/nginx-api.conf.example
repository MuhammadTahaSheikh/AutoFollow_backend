# Copy to /etc/nginx/sites-available/autofollow-api
# Then: sudo ln -s /etc/nginx/sites-available/autofollow-api /etc/nginx/sites-enabled/
#       sudo nginx -t && sudo systemctl reload nginx
#
# Replace api.bestechvision.com with your subdomain.

server {
    listen 80;
    server_name api.bestechvision.com;

    location / {
        proxy_pass http://127.0.0.1:5000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 90s;
    }
}
