PORT=5000
NODE_ENV=development

# MySQL — Local development
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=autofollow_crm

# MySQL — Hostinger (uncomment and fill in after creating DB in hPanel)
# DB_HOST=srvXXXX.hstgr.io
# DB_PORT=3306
# DB_USER=u916710688_autofollow_ai
# DB_PASSWORD=your-hostinger-password
# DB_NAME=u916710688_autofollow_ai
# DB_SKIP_CREATE=true

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# AI — Google Gemini (FREE, recommended until OpenAI billing is set up)
# Get key: https://aistudio.google.com/apikey
AI_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash-lite

# OpenAI (optional, paid)
OPENAI_API_KEY=sk-your-openai-api-key

# Resend Email — https://resend.com
# onboarding@resend.dev only delivers to your Resend signup email (not invitees).
# Production: verify your domain at resend.com/domains, add DNS in Hostinger, then use:
# EMAIL_FROM=AutoFollow <invites@bestechvision.com>
# Avoid noreply@ — Gmail often filters it. Use invites@ or hello@ instead.
RESEND_API_KEY=re_your-resend-api-key
EMAIL_FROM=AutoFollow <invites@bestechvision.com>
INVITE_REPLY_TO=you@bestechvision.com

# Frontend URL (for CORS, comma-separated)
FRONTEND_URL=http://localhost:3000

# n8n — inbound email replies webhook
# Generate secret: openssl rand -hex 32
N8N_WEBHOOK_SECRET=your-long-random-secret-here
# Optional: lock replies to one org (find your org id in the database)
# N8N_WEBHOOK_ORGANIZATION_ID=1
# Optional: same domain as EMAIL_FROM for better deliverability (e.g. https://code.bestechvision.com)
# INVITE_LINK_BASE_URL=https://code.bestechvision.com
