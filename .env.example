PORT=5000
NODE_ENV=development

# MySQL — Local development
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=autofollow_crm

# MySQL — Hostinger (uncomment and fill in after creating DB in hPanel)
# DB_HOST=srvXXXX.hstgr.io
# DB_PORT=3306
# DB_USER=u916710688_autofollow_ai
# DB_PASSWORD=your-hostinger-password
# DB_NAME=u916710688_autofollow_ai
# DB_SKIP_CREATE=true

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# AI — Google Gemini (FREE, recommended until OpenAI billing is set up)
# Get key: https://aistudio.google.com/apikey
AI_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash-lite

# OpenAI (optional, paid)
OPENAI_API_KEY=sk-your-openai-api-key

# Email delivery — n8n (recommended), Gmail SMTP, or Resend
# Full guide: backend/n8n/N8N-EMAIL-SETUP.md
EMAIL_PROVIDER=n8n
GMAIL_USER=muhammadtahakamran19@gmail.com
EMAIL_FROM=muhammadtahakamran19@gmail.com
EMAIL_FROM_NAME=bestechVison
INVITE_REPLY_TO=muhammadtahakamran19@gmail.com

# n8n outbound — CRM calls this webhook; n8n sends via Gmail OAuth
N8N_SEND_WEBHOOK_URL=https://your-n8n-instance.com/webhook/send-lead-email

# Gmail SMTP (only if EMAIL_PROVIDER=gmail — requires Google App Password)
# GMAIL_APP_PASSWORD="your-google-app-password-16-chars"

# Resend (only if EMAIL_PROVIDER=resend)
# RESEND_API_KEY=re_your-resend-api-key

# Frontend URL (for CORS, comma-separated)
FRONTEND_URL=http://localhost:3000,http://localhost:3001

# Production (Hostinger VPS / Vercel) — include your deployed frontend origin(s):
# FRONTEND_URL=https://auto-follow-frontend.vercel.app,http://localhost:3000
# NODE_ENV=production
# PORT=5000
# HOST=0.0.0.0
# BACKEND_ID=hostinger-vps

# n8n — inbound email replies webhook
# Generate secret: openssl rand -hex 32
N8N_WEBHOOK_SECRET=your-long-random-secret-here
# n8n webhook URL after Hostinger VPS deploy:
# https://api.bestechvision.com/api/webhooks/n8n/email-reply
# Optional: lock replies to one org (find your org id in the database)
# N8N_WEBHOOK_ORGANIZATION_ID=1
# Optional: same domain as EMAIL_FROM for better deliverability (e.g. https://code.bestechvision.com)
# INVITE_LINK_BASE_URL=https://code.bestechvision.com

# Stripe Billing — https://dashboard.stripe.com
# Create products/prices for Pro ($49/mo) and Agency ($149/mo), then paste price IDs
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-signing-secret
STRIPE_PRICE_PRO=price_your_pro_monthly_price_id
STRIPE_PRICE_AGENCY=price_your_agency_monthly_price_id
# Webhook endpoint: https://api.bestechvision.com/api/webhooks/stripe
# Events: checkout.session.completed, customer.subscription.updated, customer.subscription.deleted, invoice.payment_failed
