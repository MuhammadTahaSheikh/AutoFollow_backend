{
  "name": "bestechVison CRM - Send Lead Email (Gmail)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "send-lead-email",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-send",
      "name": "CRM Send Request",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0],
      "webhookId": "send-lead-email",
      "notes": "CRM POSTs here when AI follow-up sends. URL goes in backend N8N_SEND_WEBHOOK_URL"
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true },
          "conditions": [
            {
              "id": "secret-match",
              "leftValue": "={{ $json.headers['x-webhook-secret'] || $json.headers['X-Webhook-Secret'] }}",
              "rightValue": "PASTE_YOUR_N8N_WEBHOOK_SECRET_HERE",
              "operator": { "type": "string", "operation": "equals" }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "verify-secret",
      "name": "Verify Webhook Secret",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [220, 0]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "send",
        "sendTo": "={{ $json.body.to }}",
        "subject": "={{ $json.body.subject }}",
        "emailType": "text",
        "message": "={{ $json.body.body_text }}",
        "options": {
          "replyTo": "={{ $json.body.reply_to || $json.body.from_email }}"
        }
      },
      "id": "gmail-send",
      "name": "Send via Gmail",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [440, -80],
      "credentials": {
        "gmailOAuth2": {
          "id": "REPLACE_WITH_GMAIL_OAUTH_CREDENTIAL_ID",
          "name": "Gmail muhammadtahakamran19@gmail.com"
        }
      },
      "notes": "Connect Gmail with OAuth2 (no App Password needed). Sends from your connected Gmail account."
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { ok: true, message_id: $json.id || $json.messageId || '', schedule_id: $('CRM Send Request').item.json.body.schedule_id } }}",
        "options": { "responseCode": 200 }
      },
      "id": "respond-ok",
      "name": "Respond Success",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [660, -80]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { ok: false, error: 'Invalid webhook secret' } }}",
        "options": { "responseCode": 401 }
      },
      "id": "respond-unauthorized",
      "name": "Respond Unauthorized",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [440, 120]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { ok: false, error: $json.message || 'Gmail send failed' } }}",
        "options": { "responseCode": 500 }
      },
      "id": "respond-error",
      "name": "Respond Error",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [660, 80]
    }
  ],
  "connections": {
    "CRM Send Request": {
      "main": [[{ "node": "Verify Webhook Secret", "type": "main", "index": 0 }]]
    },
    "Verify Webhook Secret": {
      "main": [
        [{ "node": "Send via Gmail", "type": "main", "index": 0 }],
        [{ "node": "Respond Unauthorized", "type": "main", "index": 0 }]
      ]
    },
    "Send via Gmail": {
      "main": [
        [{ "node": "Respond Success", "type": "main", "index": 0 }],
        [{ "node": "Respond Error", "type": "main", "index": 0 }]
      ]
    }
  },
  "settings": { "executionOrder": "v1" },
  "meta": { "templateCredsSetupCompleted": false }
}
