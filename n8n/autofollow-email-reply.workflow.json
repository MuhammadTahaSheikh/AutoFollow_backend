{
  "name": "bestechVison CRM - Capture Lead Email Replies (Gmail)",
  "nodes": [
    {
      "parameters": {
        "pollTimes": {
          "item": [{ "mode": "everyMinute" }]
        },
        "filters": {
          "readStatus": "unread",
          "includeSpamTrash": false
        },
        "options": {
          "simple": false
        }
      },
      "id": "gmail-trigger",
      "name": "Poll Gmail Inbox",
      "type": "n8n-nodes-base.gmailTrigger",
      "typeVersion": 1.2,
      "position": [0, 0],
      "credentials": {
        "gmailOAuth2": {
          "id": "REPLACE_WITH_GMAIL_OAUTH_CREDENTIAL_ID",
          "name": "Gmail muhammadtahakamran19@gmail.com"
        }
      },
      "notes": "Uses the same Gmail OAuth credential as the send workflow. Polls unread INBOX every minute."
    },
    {
      "parameters": {
        "jsCode": "const OUR = 'muhammadtahakamran19@gmail.com';\nconst items = [];\nfor (const item of $input.all()) {\n  const j = item.json;\n  const fromRaw = String(j.From || j.from || '');\n  const match = fromRaw.match(/<([^>]+@[^>]+)>/i);\n  const fromEmail = (match?.[1] || fromRaw).replace(/[<>'\"]/g, '').trim().toLowerCase();\n  const subject = String(j.Subject || j.subject || '').trim();\n  if (!subject || !fromEmail.includes('@')) continue;\n  if (fromEmail === OUR.toLowerCase()) continue;\n  items.push({ json: { ...j, fromEmail } });\n}\nreturn items;"
      },
      "id": "filter-replies",
      "name": "Filter Real Lead Replies",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [220, 0],
      "notes": "Extract sender email only — avoids false drops when quoted reply text contains your address."
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "from_email",
              "name": "from_email",
              "value": "={{ $json.fromEmail || ($json.From || '').match(/<([^>]+@[^>]+)>/)?.[1] || ($json.From || '').replace(/[<>'\"]/g, '').trim() }}",
              "type": "string"
            },
            {
              "id": "from_name",
              "name": "from_name",
              "value": "={{ ($json.from?.value?.[0]?.name || $json.from?.name || $json.from || $json.From || '').toString().replace(/<.*>/, '').trim() }}",
              "type": "string"
            },
            {
              "id": "subject",
              "name": "subject",
              "value": "={{ $json.subject || $json.Subject || '' }}",
              "type": "string"
            },
            {
              "id": "body_text",
              "name": "body_text",
              "value": "={{ $json.textPlain || $json.text || $json.snippet || $json.textHtml?.replace(/<[^>]+>/g, ' ') || '' }}",
              "type": "string"
            },
            {
              "id": "body_html",
              "name": "body_html",
              "value": "={{ $json.textHtml || '' }}",
              "type": "string"
            },
            {
              "id": "message_id",
              "name": "message_id",
              "value": "={{ $json.id || $json.messageId || '' }}",
              "type": "string"
            },
            {
              "id": "received_at",
              "name": "received_at",
              "value": "={{ $json.date || $json.internalDate || $now.toISO() }}",
              "type": "string"
            },
            {
              "id": "raw_from",
              "name": "raw_from",
              "value": "={{ $json.from || $json.From || '' }}",
              "type": "string"
            },
            {
              "id": "gmail_id",
              "name": "gmail_id",
              "value": "={{ $json.id || '' }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "prepare-payload",
      "name": "Prepare CRM Payload",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [440, 0]
    },
    {
      "parameters": {
        "jsCode": "const items = [];\nfor (const item of $input.all()) {\n  let text = (item.json.body_text || '').replace(/\\r\\n/g, '\\n');\n  text = text.split(/\\nOn .+ wrote:\\s*\\n?/i)[0];\n  text = text.split(/\\nFrom: .+\\nSent:/i)[0];\n  text = text.replace(/\\n>+[\\s\\S]*/, '').trim();\n  items.push({ json: { ...item.json, body_text: text || '(No content)' } });\n}\nreturn items;"
      },
      "id": "strip-quotes",
      "name": "Strip Quoted Reply History",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [660, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://187.124.52.234/api/webhooks/n8n/email-reply",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Content-Type", "value": "application/json" },
            { "name": "x-webhook-secret", "value": "PASTE_YOUR_N8N_WEBHOOK_SECRET_HERE" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {\n  from_email: $json.from_email,\n  from: $json.raw_from || $json.from_email,\n  from_name: $json.from_name,\n  subject: $json.subject,\n  body_text: $json.body_text,\n  body_html: $json.body_html || '',\n  message_id: String($json.message_id || ''),\n  received_at: $json.received_at,\n  source: 'n8n'\n} }}",
        "options": {}
      },
      "id": "crm-webhook",
      "name": "Send to CRM Webhook",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [880, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true },
          "conditions": [
            {
              "id": "status-ok",
              "leftValue": "={{ $json.statusCode }}",
              "rightValue": 201,
              "operator": { "type": "number", "operation": "equals" }
            },
            {
              "id": "status-dup",
              "leftValue": "={{ $json.statusCode }}",
              "rightValue": 200,
              "operator": { "type": "number", "operation": "equals" }
            }
          ],
          "combinator": "or"
        }
      },
      "id": "check-response",
      "name": "Check CRM Response",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1100, 0]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "markAsRead",
        "messageId": "={{ $('Prepare CRM Payload').item.json.gmail_id }}"
      },
      "id": "mark-read",
      "name": "Mark as Read",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [1320, -40],
      "credentials": {
        "gmailOAuth2": {
          "id": "REPLACE_WITH_GMAIL_OAUTH_CREDENTIAL_ID",
          "name": "Gmail muhammadtahakamran19@gmail.com"
        }
      }
    }
  ],
  "connections": {
    "Poll Gmail Inbox": {
      "main": [[{ "node": "Filter Real Lead Replies", "type": "main", "index": 0 }]]
    },
    "Filter Real Lead Replies": {
      "main": [[{ "node": "Prepare CRM Payload", "type": "main", "index": 0 }]]
    },
    "Prepare CRM Payload": {
      "main": [[{ "node": "Strip Quoted Reply History", "type": "main", "index": 0 }]]
    },
    "Strip Quoted Reply History": {
      "main": [[{ "node": "Send to CRM Webhook", "type": "main", "index": 0 }]]
    },
    "Send to CRM Webhook": {
      "main": [[{ "node": "Check CRM Response", "type": "main", "index": 0 }]]
    },
    "Check CRM Response": {
      "main": [
        [{ "node": "Mark as Read", "type": "main", "index": 0 }],
        []
      ]
    }
  },
  "settings": { "executionOrder": "v1" },
  "meta": { "templateCredsSetupCompleted": false }
}
